{
  "__repro_meta__": {
    "group": "row2-memory-lancedb",
    "claim_class": "strict",
    "audit_freeze": {
      "lancedb_embedding_provider": "${LANCEDB_EMBEDDING_PROVIDER}"
    },
    "notes": [
      "Runtime shape matches the current memory-lancedb plugin path under plugins.entries.memory-lancedb.config.",
      "The runtime plugin config itself consumes model/baseUrl/apiKey/dimensions; provider is preserved separately in audit_freeze so materialization and host-level freeze can record the resolved embedding provider explicitly."
    ]
  },
  "plugins": {
    "slots": {
      "memory": "memory-lancedb",
      "contextEngine": "legacy"
    },
    "entries": {
      "memory-lancedb": {
        "enabled": true,
        "config": {
          "dbPath": "storage/{run_id}/{group}/lancedb",
          "embedding": {
            "apiKey": "${LANCEDB_EMBEDDING_API_KEY}",
            "model": "${LANCEDB_EMBEDDING_MODEL}",
            "baseUrl": "${LANCEDB_EMBEDDING_API_BASE}",
            "dimensions": "${LANCEDB_EMBEDDING_DIMENSION}"
          },
          "autoCapture": true,
          "autoRecall": true
        }
      }
    }
  }
}